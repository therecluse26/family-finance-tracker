# The app's settings (spec 12, The folder). Copy this file to .env. Members enter every other
# setting in the app.

# The address Members open, such as https://money.example.com. It sets the security mode. Required.
APP_URL=

# The port the app listens on.
PORT=3000

# The proxies whose forwarded headers the app trusts. Empty trusts none.
TRUSTED_PROXIES=

# Optional: the UID and GID the app runs as, for a NAS share that needs a set owner.
# PUID=1000
# PGID=1000
