{
  "name": "family-finance-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted, read-only tracker for one Household's personal finances.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therecluse26/family-finance-tracker.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.server.config.ts && node scripts/write-notices.ts",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web",
    "test": "vitest run",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:audit": "node scripts/check-audit.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "@sidequest/sqlite-backend": "~1.17.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sidequest": "~1.17.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
