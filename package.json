{
  "name": "family-finance-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hosted, read-only tracker for one Household's personal finances.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therecluse26/family-finance-tracker.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.server.config.ts && vite build --config vite.fft.config.ts && node scripts/write-notices.ts",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web",
    "test": "vitest run",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:audit": "node scripts/check-audit.ts",
    "check:benchmarks": "node scripts/check-benchmark-snapshot.ts",
    "db:generate": "drizzle-kit generate",
    "seed:demo": "node scripts/seed-demo.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.93",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/openai-compatible": "3.0.82",
    "@better-auth/utils": "^0.5.1",
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@sidequest/sqlite-backend": "~1.17.0",
    "ai": "7.0.158",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "munkres": "2.1.1",
    "plaid": "^49.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sidequest": "~1.17.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
